    <item>
      <title>1.0.0-rc.10</title>
      <pubDate>Mon, 28 Sep 2026 20:11:29 GMT</pubDate>
      <sparkle:version>202609282009</sparkle:version>
      <sparkle:shortVersionString>1.0.0-rc.10</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <sparkle:channel>beta</sparkle:channel>
      <link>https://github.com/xuancongwen/bellow-app/releases/tag/v1.0.0-rc.10</link>
      <description>&lt;p&gt;Bellow 1.0.0-rc.10 keeps dictating when your Mac runs low on memory. Cleanup continues while you dictate; after three idle minutes, or at once if memory gets critically low, Bellow unloads its cleanup model and types your words as heard until memory frees up.&lt;/p&gt;
&lt;p&gt;Also in this release: cleanup no longer answers or translates what you dictate, Max and Standard handle self-corrections, emails, and spoken addresses better, and release candidates now check for updates every 30 minutes.&lt;/p&gt;
&lt;p&gt;&lt;a href="https://github.com/xuancongwen/bellow-app/releases/tag/v1.0.0-rc.10"&gt;Full release notes&lt;/a&gt;&lt;/p&gt;
</description>
      <enclosure url="https://github.com/xuancongwen/bellow-app/releases/download/v1.0.0-rc.10/Bellow-1.0.0-rc.10-macOS-arm64.dmg" length="24476709" type="application/octet-stream" sparkle:edSignature="y9BjzTOtmlSQORyIL/2IajBu6UFAAHZhTZq6zjrroH8hoDUMV4us0TBrxvl9nR9TEEUe03Fz5zXGqlzjDuZ8AQ==" />
